# ========================================================
# RepoRevive Environment Configuration Template
# ========================================================

# --- Express API Server ---
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/reporevive
JWT_SECRET=reporevive-dev-jwt-secret-replace-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# --- AI Service Integration ---
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=reporevive-internal-ai-service-key-change-me

# --- GitHub Ingestion & Analysis ---
# GitHub Personal Access Token (classic or fine-grained with read access to public repos)
GITHUB_TOKEN=ghp_example_token_placeholder

# --- Business Rules & Caps ---
DAILY_ANALYSIS_CAP_PER_USER=15
AUTO_ANALYZE_TOP_K=5
CACHE_TTL_HOURS=24
STALE_MONTHS=12
MIN_COMMITS=30

# --- Ranking Formula Weights (Sum = 1.0) ---
RANK_W_RELEVANCE=0.40
RANK_W_COVERAGE=0.30
RANK_W_VIABILITY=0.30

# --- AI Service (Python FastAPI) ---
AI_HOST=0.0.0.0
AI_PORT=8000
# LLM Provider options: mock | anthropic | openai_compatible
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=sk-ant-api03-example
OPENAI_API_KEY=sk-example
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Agent Guardrails ---
AGENT_MAX_STEPS=10
AGENT_MAX_TOKENS_PER_RUN=16000
AGENT_STEP_TIMEOUT_SECONDS=30

# --- Client (React + Vite) ---
VITE_API_URL=http://localhost:5000/api
